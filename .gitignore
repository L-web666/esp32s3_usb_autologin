# Node.js dependencies
node_modules/

# Build output from Vite
site/dist/

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# PlatformIO project files
.pio/

# OS-specific files
.DS_Store
Thumbs.db

# Autogenerated files
site/public/firmware/*.bin
site/public/firmware/*.json

# Editor directories and files
.vscode/*
#!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Ignore secure files
Secure.h
secure.js
settingsSecure.json
buttonsSecure.json
categoriesSecure.json

# Build artifacts (do not commit firmware binaries)
.pio/
_build_output/
*.bin
*.elf
*.map

# EXCEPTION: the browser flasher needs its firmware committed so that
# visitors can install it straight from GitHub Pages. If the 7.9 MB file
# makes the repo too heavy, move it to GitHub Releases and point
# docs/manifest.json at the release asset URL instead.
!docs/firmware/*.bin

# Local toolchain / package caches (slow-network offline builds)
dl/
pio_core/
_index/
*.tar.gz
*.log
